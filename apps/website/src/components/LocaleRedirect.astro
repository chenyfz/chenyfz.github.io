---
interface Props { path?: string; }
const { path = '' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex" /><title>Chen Yangfan</title></head>
  <body>
    <p><a href={`/zh/${path}`}>中文</a> · <a href={`/en/${path}`}>English</a></p>
    <script is:inline define:vars={{ path }}>
      const languages = navigator.languages?.length ? navigator.languages : [navigator.language];
      const locale = languages.some(language => String(language).toLowerCase().startsWith('zh')) ? 'zh' : 'en';
      window.location.replace(`/${locale}/${path}${window.location.search}${window.location.hash}`);
    </script>
  </body>
</html>
