---
import Layout from '@/layouts/Layout.astro';
import { locales, requireLocaleParam } from '@/i18n/config';
import { t } from '@/i18n/t';
import staticCvEn from '@/i18n/pages/static-cv/en';
import staticCvZh from '@/i18n/pages/static-cv/zh';
import StaticCvSection from '@/components/cv/StaticCv';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const locale = requireLocaleParam(typeof rawLang === 'string' ? rawLang : undefined);
const pageText = t({ en: staticCvEn, zh: staticCvZh }, locale);
---

<Layout lang={locale} title={pageText.meta.title} description={pageText.meta.description} pageId="static-cv">
  <StaticCvSection text={pageText} lang={locale} client:load />
</Layout>
