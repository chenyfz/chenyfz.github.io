---
import Layout from '@/layouts/Layout.astro';
import LocaleRedirect from '@/components/LocaleRedirect.astro';
import { defaultLocale } from '@/i18n/config';
import { t } from '@/i18n/t';
import indexEn from '@/i18n/pages/index/en';
import indexZh from '@/i18n/pages/index/zh';

const pageText = t({ en: indexEn, zh: indexZh }, defaultLocale);
---

<Layout lang={defaultLocale} title={pageText.meta.title} description={pageText.meta.description}>
	<LocaleRedirect />
</Layout>
