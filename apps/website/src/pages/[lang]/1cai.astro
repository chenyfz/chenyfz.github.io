---
import Layout from '@/layouts/Layout.astro';
import { getLocaleStaticPaths, requireLocaleParam } from '@/i18n/config';
import { t } from '@/i18n/t';
import OnecaiPage from '@/components/onecai/OnecaiPage';
import onecaiEn from '@/i18n/pages/onecai/en';
import onecaiZh from '@/i18n/pages/onecai/zh';

export const getStaticPaths = getLocaleStaticPaths;

const locale = requireLocaleParam(Astro.params.lang);
const text = t({ en: onecaiEn, zh: onecaiZh }, locale);
---

<Layout pageId="1cai" title={text.meta.title} description={text.meta.description} lang={locale}>
  <OnecaiPage text={text} lang={locale} client:load transition:persist="1cai-page" transition:animate="none" />
</Layout>
