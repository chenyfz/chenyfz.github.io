---
import Layout from '@/layouts/Layout.astro';
import { locales, requireLocaleParam } from '@/i18n/config';
import { t } from '@/i18n/t';
import mastersCoursesEn from '@/i18n/pages/masters-courses/en';
import mastersCoursesZh from '@/i18n/pages/masters-courses/zh';
import MastersCoursesPage from '@/components/masters-courses/MastersCoursesPage';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const locale = requireLocaleParam(typeof rawLang === 'string' ? rawLang : undefined);
const pageText = t({ en: mastersCoursesEn, zh: mastersCoursesZh }, locale);
---

<Layout lang={locale} title={pageText.meta.title} description={pageText.meta.description} pageId="masters-courses">
  <MastersCoursesPage text={pageText} lang={locale} client:load />
</Layout>
