---
import Layout from '@/layouts/Layout.astro';
import { getLocaleStaticPaths, requireLocaleParam } from '@/i18n/config';
import { t } from '@/i18n/t';
import graduationThesisEn from '@/i18n/pages/graduation-thesis/en';
import graduationThesisZh from '@/i18n/pages/graduation-thesis/zh';
import GraduationThesisPage from '@/components/graduation-thesis/GraduationThesisPage';

export const getStaticPaths = getLocaleStaticPaths;

const locale = requireLocaleParam(Astro.params.lang);
const pageText = t({ en: graduationThesisEn, zh: graduationThesisZh }, locale);
---

<Layout lang={locale} title={pageText.meta.title} description={pageText.meta.description} pageId="graduation-thesis">
  <GraduationThesisPage text={pageText} lang={locale} client:load transition:persist="graduation-thesis-page" transition:animate="none" />
</Layout>
