{
  "name": "ohyangfan-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm --filter apps-website run build",
    "lint:script": "pnpm -r run lint:script",
    "lint:markup": "pnpm -r run lint:markup"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "command -v node >/dev/null || eval \"$(fnm env --shell bash 2>/dev/null)\" || true; pnpm lint:script"
  }
}
