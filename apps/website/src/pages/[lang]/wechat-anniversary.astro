---
import Layout from '@/layouts/Layout.astro';
import { getLocaleStaticPaths, requireLocaleParam } from '@/i18n/config';
import WechatAnniversaryShowcasePage from '@/components/showcase/WechatAnniversaryShowcasePage';

export const getStaticPaths = getLocaleStaticPaths;

const locale = requireLocaleParam(Astro.params.lang);
const pageMeta = locale === 'zh'
  ? {
      title: '微信十周年内部活动 | 陈扬帆',
      description: '微信十周年内部活动展示页。'
    }
  : {
      title: 'WeChat 10th Anniversary | Chen Yangfan',
      description: 'Showcase page for WeChat 10th anniversary internal mini program.'
    };
---

<Layout pageId="wechat-anniversary" title={pageMeta.title} description={pageMeta.description} lang={locale}>
  <WechatAnniversaryShowcasePage lang={locale} client:load transition:persist="wechat-anniversary-page" transition:animate="none" />
</Layout>
