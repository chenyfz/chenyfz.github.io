{
  "name": "ohyangfan-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "postinstall": "simple-git-hooks",
    "dev": "pnpm -r --parallel --if-present run dev",
    "build": "pnpm --filter apps-website run build",
    "lint:script": "pnpm exec oxlint apps/website/src"
  },
  "devDependencies": {
    "oxlint": "^1.46.0",
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint:script"
  }
}
