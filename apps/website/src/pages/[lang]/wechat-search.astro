---
import Layout from '@/layouts/Layout.astro';
import { getLocaleStaticPaths, requireLocaleParam } from '@/i18n/config';
import WechatSearchShowcasePage from '@/components/showcase/WechatSearchShowcasePage';

export const getStaticPaths = getLocaleStaticPaths;

const locale = requireLocaleParam(Astro.params.lang);
const pageMeta = locale === 'zh'
  ? {
      title: '搜一搜前端重构 | 陈扬帆',
      description: '微信搜一搜前端重构展示页。'
    }
  : {
      title: 'Weixin Search Frontend | Chen Yangfan',
      description: 'Showcase page for Weixin Search frontend refactor.'
    };
---

<Layout pageId="wechat-search" title={pageMeta.title} description={pageMeta.description} lang={locale}>
  <WechatSearchShowcasePage lang={locale} client:load transition:persist="wechat-search-page" transition:animate="none" />
</Layout>
