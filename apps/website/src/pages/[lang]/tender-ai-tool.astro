---
import Layout from '@/layouts/Layout.astro';
import { getLocaleStaticPaths, requireLocaleParam } from '@/i18n/config';
import TenderAiToolShowcasePage from '@/components/showcase/TenderAiToolShowcasePage';

export const getStaticPaths = getLocaleStaticPaths;

const locale = requireLocaleParam(Astro.params.lang);
const pageMeta = locale === 'zh'
  ? {
      title: '招投标领域 AI 工具 | 陈扬帆',
      description: '一成智能招投标领域 AI 工具展示页。'
    }
  : {
      title: 'AI Tooling for Tender Review | Chen Yangfan',
      description: 'Showcase page for the 1cAI tender review product.'
    };
---

<Layout pageId="tender-ai-tool" title={pageMeta.title} description={pageMeta.description} lang={locale}>
  <TenderAiToolShowcasePage lang={locale} client:load transition:persist="tender-ai-tool-page" transition:animate="none" />
</Layout>
