---
import Layout from '@/layouts/Layout.astro';
import { locales, requireLocaleParam } from '@/i18n/config';
import WechatAnniversaryShowcasePage from '@/components/showcase/WechatAnniversaryShowcasePage';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const locale = requireLocaleParam(typeof rawLang === 'string' ? rawLang : undefined);
const pageMeta = locale === 'zh'
  ? {
      title: '微信十周年内部活动 | 陈扬帆',
      description: '微信十周年内部活动展示页。'
    }
  : {
      title: 'WeChat 10th Anniversary | Chen Yangfan',
      description: 'Showcase page for WeChat 10th anniversary internal mini program.'
    };
---

<Layout title={pageMeta.title} description={pageMeta.description} lang={locale}>
  <WechatAnniversaryShowcasePage lang={locale} client:load />
</Layout>
