---
import Layout from '@/layouts/Layout.astro';
import { getLocaleStaticPaths, requireLocaleParam } from '@/i18n/config';

export const getStaticPaths = getLocaleStaticPaths;

const locale = requireLocaleParam(Astro.params.lang);
---

<Layout lang={locale} title={locale === 'zh' ? '实验页面 | 陈扬帆' : 'Playground | Chen Yangfan'} description={locale === 'zh' ? '实验页面' : 'Experimental page'} pageId="playground">
</Layout>
