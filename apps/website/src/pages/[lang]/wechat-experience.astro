---
import Layout from '@/layouts/Layout.astro';
import { locales, requireLocaleParam } from '@/i18n/config';
import { t } from '@/i18n/t';
import WechatExperiencePage from '@/components/wechat-experience/WechatExperiencePage';
import wechatExperienceEn from '@/i18n/pages/wechat-experience/en';
import wechatExperienceZh from '@/i18n/pages/wechat-experience/zh';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const locale = requireLocaleParam(typeof rawLang === 'string' ? rawLang : undefined);
const text = t({ en: wechatExperienceEn, zh: wechatExperienceZh }, locale);
---

<Layout title={text.meta.title} description={text.meta.description} lang={locale}>
  <WechatExperiencePage text={text} lang={locale} />
</Layout>
