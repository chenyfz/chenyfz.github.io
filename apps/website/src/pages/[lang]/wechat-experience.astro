---
import Layout from '@/layouts/Layout.astro';
import { getLocaleStaticPaths, requireLocaleParam } from '@/i18n/config';
import { t } from '@/i18n/t';
import WechatExperiencePage from '@/components/wechat-experience/WechatExperiencePage';
import wechatExperienceEn from '@/i18n/pages/wechat-experience/en';
import wechatExperienceZh from '@/i18n/pages/wechat-experience/zh';

export const getStaticPaths = getLocaleStaticPaths;

const locale = requireLocaleParam(Astro.params.lang);
const text = t({ en: wechatExperienceEn, zh: wechatExperienceZh }, locale);
---

<Layout pageId="wechat-experience" title={text.meta.title} description={text.meta.description} lang={locale}>
  <WechatExperiencePage text={text} lang={locale} client:load transition:persist="wechat-experience-page" transition:animate="none" />
</Layout>
