---
import Layout from '@/layouts/Layout.astro';
import { locales, requireLocaleParam } from '@/i18n/config';
import { t } from '@/i18n/t';
import YichengIntelligencePage from '@/components/yicheng-intelligence/YichengIntelligencePage';
import yichengIntelligenceEn from '@/i18n/pages/yicheng-intelligence/en';
import yichengIntelligenceZh from '@/i18n/pages/yicheng-intelligence/zh';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const rawLang = Astro.params.lang;
const locale = requireLocaleParam(typeof rawLang === 'string' ? rawLang : undefined);
const text = t({ en: yichengIntelligenceEn, zh: yichengIntelligenceZh }, locale);
---

<Layout title={text.meta.title} description={text.meta.description} lang={locale}>
  <YichengIntelligencePage text={text} lang={locale} />
</Layout>
